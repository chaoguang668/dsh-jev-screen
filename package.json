  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "chaoguang668",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaoguang668/dsh-jev-screen.git"
  },
  "bugs": {
    "url": "https://github.com/chaoguang668/dsh-jev-screen/issues"
  },
  "homepage": "https://github.com/chaoguang668/dsh-jev-screen#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "jev",
    "typesafe",
    "openjev",
    "codiv",
    "semantic-search",
    "rerank",
    "system-one"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
